{
  "name": "zeungbaram-overlay",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/engine/engine.test.ts src/engine/search.test.ts src/engine/match.test.ts src/capture/recognize.test.ts",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "release": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/kor": "^1.0.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "version": "0.1.3",
  "build": {
    "appId": "com.mohazi.overlay",
    "productName": "MoHaZi",
    "files": [
      "out/**"
    ],
    "asar": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "perMachine": false,
      "shortcutName": "MoHaZi"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Yooze0x4c8",
        "repo": "MoHaZi",
        "releaseType": "release"
      }
    ]
  }
}
