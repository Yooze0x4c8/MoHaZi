{
  "name": "zeungbaram-overlay",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/engine/engine.test.ts src/engine/search.test.ts src/engine/match.test.ts src/capture/recognize.test.ts",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "release": "electron-vite build && electron-builder --win nsis --publish always",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "version": "0.3.0",
  "build": {
    "appId": "com.mohazi.overlay",
    "productName": "MoHaZi",
    "files": [
      "out/**"
    ],
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "perMachine": false,
      "shortcutName": "MoHaZi",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "displayLanguageSelector": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Yooze0x4c8",
        "repo": "MoHaZi",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/tray",
        "to": "tray"
      },
      {
        "from": "resources/intro",
        "to": "intro"
      }
    ],
    "afterPack": "build/adhoc-sign.cjs"
  }
}
